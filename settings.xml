<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings that bypass the corporate gcrm-central mirror
  (configured globally in ~/.m2/settings.xml) so we can resolve public
  dependencies straight from Maven Central, e.g.:
    mvn -s settings.xml dependency:get -Dartifact=<groupId>:<artifactId>:<version>
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
</settings>